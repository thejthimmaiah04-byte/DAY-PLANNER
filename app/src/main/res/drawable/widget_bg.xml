<?xml version="1.0" encoding="utf-8"?>
<!-- Solid ink card behind the two widget bitmaps, so any scaling gap between
     the clock and the task list reads as one continuous card, never wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0B0C10" />
    <corners android:radius="28dp" />
</shape>
